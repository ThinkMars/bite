{
  "name": "bite",
  "version": "0.0.1",
  "description": "Bite is a web build tool that build your web application.",
  "module": "dist/index.js",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "web",
    "build",
    "tool",
    "bun",
    "typescript"
  ],
  "author": "ThinkMars",
  "license": "MIT",
  "bin": {
    "bite": "./bin/bite.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ThinkMars/bite"
  },
  "bugs": {
    "url": "https://github.com/ThinkMars/bite/issues"
  },
  "scripts": {
    "build": "premove dist && bun run scripts/build-bunde.ts",
    "dev": "bun --hot scripts/build-bunde.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "chokidar": "^4.0.3",
    "premove": "^4.0.0"
  }
}